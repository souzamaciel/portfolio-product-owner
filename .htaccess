RewriteEngine On
Options -MultiViews

# Se alguém acessar a URL com .html explícito, redireciona (301) para a versão limpa.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve o arquivo .html internamente quando a URL limpa é solicitada.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
